<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification project for batch-12/13 logic. It is deliberately standalone:
      * not referenced by StrmAssistant.sln or StrmAssistant.csproj;
      * links the real source files from ../../StrmAssistant/Common (no copied logic);
      * supplies the minimal Emby/plugin shims the linked files reference (see src/Shims.cs).
    Run with:
      DOTNET_ROOT=/home/Shiyi/.dotnet /home/Shiyi/.dotnet/dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StrmAssistant.Verification</AssemblyName>
    <RootNamespace>StrmAssistant.Verification</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\StrmAssistant\Common\SourceBackoff.cs" Link="src\SourceBackoff.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DvP7Api.cs" Link="src\DvP7Api.cs" />
    <Compile Include="..\..\StrmAssistant\Common\ResumePositionMath.cs" Link="src\ResumePositionMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
