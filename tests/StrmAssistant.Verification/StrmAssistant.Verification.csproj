<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification project for batch-12/13/15 logic. It is deliberately standalone:
      * not referenced by StrmAssistant.sln or StrmAssistant.csproj;
      * links the real source files from ../../StrmAssistant/Common (no copied logic);
      * supplies the minimal Emby/plugin shims the linked files reference (see src/Shims.cs,
        src/EmbyShims.cs and src/FfmpegApiShim.cs).
    Run with:
      DOTNET_ROOT=/home/Shiyi/.dotnet /home/Shiyi/.dotnet/dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StrmAssistant.Verification</AssemblyName>
    <RootNamespace>StrmAssistant.Verification</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\StrmAssistant\Common\SourceBackoff.cs" Link="src\SourceBackoff.cs" />
    <Compile Include="..\..\StrmAssistant\Common\MetadataDiff.cs" Link="src\MetadataDiff.cs" />
    <Compile Include="..\..\StrmAssistant\Common\ProviderSearchKeys.cs" Link="src\ProviderSearchKeys.cs" />
    <Compile Include="..\..\StrmAssistant\Common\TagListMatcher.cs" Link="src\TagListMatcher.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DvP7Api.cs" Link="src\DvP7Api.cs" />
    <Compile Include="..\..\StrmAssistant\Common\ResumePositionMath.cs" Link="src\ResumePositionMath.cs" />
    <Compile Include="..\..\StrmAssistant\Common\CustomFfprobeApi.cs" Link="src\CustomFfprobeApi.cs" />
    <Compile Include="..\..\StrmAssistant\Common\StrmUrlHelper.cs" Link="src\StrmUrlHelper.cs" />
    <Compile Include="..\..\StrmAssistant\Common\VersionPlaybackApi.cs" Link="src\VersionPlaybackApi.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LanguageUtility.cs" Link="src\LanguageUtility.cs" />
    <Compile Include="..\..\StrmAssistant\Common\SearchTextHelper.cs" Link="src\SearchTextHelper.cs" />
    <Compile Include="..\..\StrmAssistant\Common\OverrideImageMatcher.cs" Link="src\OverrideImageMatcher.cs" />
    <Compile Include="..\..\StrmAssistant\Common\MediaInfoQueueAdmission.cs" Link="src\MediaInfoQueueAdmission.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LogLimiter.cs" Link="src\LogLimiter.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LibraryScopeParser.cs" Link="src\LibraryScopeParser.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DoubanRatingPruner.cs" Link="src\DoubanRatingPruner.cs" />
    <Compile Include="..\..\StrmAssistant\Common\MediaRootsCachePolicy.cs" Link="src\MediaRootsCachePolicy.cs" />
    <Compile Include="..\..\StrmAssistant\Common\SingleCharacterSearchPolicy.cs" Link="src\SingleCharacterSearchPolicy.cs" />
    <Compile Include="..\..\StrmAssistant\Common\ThumbnailRefreshSignature.cs" Link="src\ThumbnailRefreshSignature.cs" />
    <Compile Include="..\..\StrmAssistant\Common\ScheduledTaskFailurePolicy.cs" Link="src\ScheduledTaskFailurePolicy.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DashboardStats.cs" Link="src\DashboardStats.cs" />
    <Compile Include="..\..\StrmAssistant\Common\PersonRefreshRules.cs" Link="src\PersonRefreshRules.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DoubanCastRules.cs" Link="src\DoubanCastRules.cs" />
    <Compile Include="..\..\StrmAssistant\Common\MiniJson.cs" Link="src\MiniJson.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LocalMetadataFileKind.cs" Link="src\LocalMetadataFileKind.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LocalMetadataPatcher.cs" Link="src\LocalMetadataPatcher.cs" />
    <Compile Include="..\..\StrmAssistant\Common\CertificationFallback.cs" Link="src\CertificationFallback.cs" />
    <Compile Include="..\..\StrmAssistant\Common\LocalMetadataItemRules.cs" Link="src\LocalMetadataItemRules.cs" />
    <Compile Include="..\..\StrmAssistant\Common\PluginUpdateInstaller.cs" Link="src\PluginUpdateInstaller.cs" />
    <Compile Include="..\..\StrmAssistant\Common\DiscMainVideoResolver.cs" Link="src\DiscMainVideoResolver.cs" />
    <Compile Include="..\..\StrmAssistant\Properties\SatelliteResourceManager.cs" Link="src\SatelliteResourceManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SearchTextHelper: pinyin generation and simplified/traditional conversion. -->
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0" />
    <PackageReference Include="CHTCHSConv" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
