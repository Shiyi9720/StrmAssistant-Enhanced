<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <AssemblyVersion>2.0.0.27</AssemblyVersion>
    <FileVersion>2.0.0.27</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>$(MSBuildProjectName)Lite</AssemblyName>
    <!-- 用运行中 Emby 自带的程序集编译时，应指向其 /system 目录（默认 lib/emby）；
         没有该目录则回退到 NuGet SDK 包。程序集版本必须与服务器完全一致，否则 Emby 拒绝加载。 -->
    <EmbyServerDir Condition="'$(EmbyServerDir)' == ''">$(MSBuildProjectDirectory)/../lib/emby</EmbyServerDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EmbyServerDir)/MediaBrowser.Model.dll')">
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Model.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Common.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Naming.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Media.Model.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Web.GenericEdit.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(EmbyServerDir)/MediaBrowser.Model.dll')">
    <!-- NuGet SDK 包版本串无法被 NuGet 解析为合法 SemVer，故不再回退；请把服务端 DLL 放进 lib/emby。 -->
  </ItemGroup>
  <ItemGroup>
    <None Remove="Web\Resources\shortcuts.js" />
    <None Remove="Web\Resources\strmassistant.js" />
    <None Remove="Web\Resources\introsettings.html" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Web\Resources\shortcuts.js" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
    <EmbeddedResource Include="Web\Resources\introsettings.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0" />
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Lib.Harmony only ships a reference assembly for netstandard2.0, so NuGet does not copy a
      runtime assembly for a netstandard2.1 project. Compile against the reference assembly and
      copy the net8.0 implementation (Emby 4.10 runs on .NET 8) next to the plugin; ILRepack
      then merges it into the plugin assembly.
    -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6" GeneratePathProperty="true" />
    <None Include="$(PkgLib_Harmony)/lib/net8.0/0Harmony.dll" Link="0Harmony.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Runtime.Loader" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Resource.Embedder 把 zh/zh-hant 卫星程序集内嵌进主 DLL；非 Windows 也可用 -->
    <PackageReference Include="Resource.Embedder" Version="2.2.0" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    Optional ILRepack step: merges 0Harmony.dll, ChineseConverter.dll and ToolGood.Words.Pinyin.dll
    into the plugin assembly.
    It only runs when an output path is supplied, so that building on a developer
    machine (including macOS) does not depend on a Windows-only %AppData% path.

    Example:
      dotnet build -c Release -p:EmbyPluginPath=/path/to/emby/programdata/plugins
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(EmbyPluginPath)' != ''">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="&quot;$(ILRepack)&quot; /out:&quot;$(EmbyPluginPath)/$(TargetFileName)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)0Harmony.dll&quot; &quot;$(TargetDir)ChineseConverter.dll&quot; &quot;$(TargetDir)ToolGood.Words.Pinyin.dll&quot; /lib:&quot;$(TargetDir)&quot;" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="dotnet &quot;$(ILRepack)&quot; /out:&quot;$(EmbyPluginPath)/$(TargetFileName)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)0Harmony.dll&quot; &quot;$(TargetDir)ChineseConverter.dll&quot; &quot;$(TargetDir)ToolGood.Words.Pinyin.dll&quot; /lib:&quot;$(TargetDir)&quot;" />
  </Target>
</Project>
