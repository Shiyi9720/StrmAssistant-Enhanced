<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <AssemblyVersion>1.0.2</AssemblyVersion>
    <FileVersion>1.0.2</FileVersion>
    <InformationalVersion>1.0.2+emby.4.10.2.0</InformationalVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>$(MSBuildProjectName)Lite</AssemblyName>
    <!-- 用运行中 Emby 自带的程序集编译时，应指向其 /system 目录（默认 lib/emby）；
         没有该目录则回退到 NuGet SDK 包。程序集版本必须与服务器完全一致，否则 Emby 拒绝加载。 -->
    <EmbyServerDir Condition="'$(EmbyServerDir)' == ''">$(MSBuildProjectDirectory)/../lib/emby</EmbyServerDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EmbyServerDir)/MediaBrowser.Model.dll')">
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Model.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/MediaBrowser.Common.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Naming.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Media.Model.dll" Private="false" />
    <Reference Include="$(EmbyServerDir)/Emby.Web.GenericEdit.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(EmbyServerDir)/MediaBrowser.Model.dll')">
    <!-- NuGet SDK 包版本串无法被 NuGet 解析为合法 SemVer，故不再回退；请把服务端 DLL 放进 lib/emby。 -->
  </ItemGroup>
  <ItemGroup>
    <None Remove="Web\Resources\shortcuts.js" />
    <None Remove="Web\Resources\strmassistant.js" />
    <None Remove="Web\Resources\introsettings.html" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Web\Resources\shortcuts.js" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
    <EmbeddedResource Include="Web\Resources\introsettings.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.1.0" />
    <!--
      HarmonyX, not Lib.Harmony: Lib.Harmony 2.3.6 ships a single 0Harmony.dll with the MonoMod
      types embedded. When Emby (or another plugin) also loads MonoMod.Utils, the two type
      identities collide ("CecilILGenerator violates the constraint on ILGeneratorProxy[TTarget]").
      HarmonyX keeps 0Harmony.dll, MonoMod.Core.dll and MonoMod.Utils.dll as separate assemblies,
      so every consumer binds to one shared type identity.
      Do NOT ILRepack 0Harmony/MonoMod into the plugin assembly: merging them back would recreate
      exactly the duplicate-type problem. All dependency DLLs are deployed next to the plugin.
    -->
    <PackageReference Include="HarmonyX" Version="2.16.1" />
    <PackageReference Include="System.Runtime.Loader" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Resource.Embedder 把 zh/zh-hant 卫星程序集内嵌进主 DLL；非 Windows 也可用 -->
    <PackageReference Include="Resource.Embedder" Version="2.2.0" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    Optional deployment step. It copies the plugin assembly and every dependency DLL next to it.
    Emby loads the plugin main assembly with Assembly.Load(bytes), so the default probing path
    never looks inside the plugin directory; Plugin's AssemblyResolve hook resolves each
    dependency by simple name from this directory. Therefore the Harmony/MonoMod closure must be
    deployed as separate files:
      0Harmony.dll, MonoMod.Core.dll, MonoMod.Utils.dll, MonoMod.RuntimeDetour.dll,
      MonoMod.Backports.dll, MonoMod.ILHelpers.dll, MonoMod.Iced.dll,
      Mono.Cecil*.dll, ChineseConverter.dll, ToolGood.Words.Pinyin.dll and the remaining
      System.* dependency DLLs produced by the NuGet restore.
    It only runs when an output path is supplied, so a developer build (including macOS) does not
    depend on a Windows-only %AppData% path.

    Example:
      dotnet build -c Release -p:EmbyPluginPath=/path/to/emby/programdata/plugins
  -->
  <!--
    Fail the build if the HarmonyX closure that must be deployed as separate files is missing.
    0Harmony must never absorb MonoMod again (that recreates the duplicate type identity).
  -->
  <Target Name="VerifyModDependencies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <Error Condition="!Exists('$(TargetDir)0Harmony.dll')"
           Text="0Harmony.dll is missing from the build output; HarmonyX did not restore correctly." />
    <Error Condition="!Exists('$(TargetDir)MonoMod.Core.dll')"
           Text="MonoMod.Core.dll is missing from the build output; it must be deployed next to the plugin." />
    <Error Condition="!Exists('$(TargetDir)MonoMod.Utils.dll')"
           Text="MonoMod.Utils.dll is missing from the build output; it must be deployed next to the plugin." />
    <Error Condition="!Exists('$(TargetDir)MonoMod.RuntimeDetour.dll')"
           Text="MonoMod.RuntimeDetour.dll is missing from the build output; it must be deployed next to the plugin." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(EmbyPluginPath)' != '' AND '$(TargetFramework)' != ''">
    <ItemGroup>
      <!-- 只放主程序集到顶层；依赖由 DeployPluginDependencies 落到 <AssemblyName>.deps/ -->
      <DeployAssemblies Include="$(TargetPath)" />
      <DeployZh Include="$(TargetDir)zh/**/*" />
      <DeployZhHant Include="$(TargetDir)zh-hant/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployAssemblies)" DestinationFolder="$(EmbyPluginPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployZh)" DestinationFolder="$(EmbyPluginPath)/zh/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployZhHant)" DestinationFolder="$(EmbyPluginPath)/zh-hant/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <!--
    依赖程序集不复制到 plugins 顶层：Emby 启动 Discovery 会把顶层的每个 *.dll 按字节加载并
    GetTypes（ApplicationHost.DiscoverTypes），而按字节加载的程序集不会按名字绑定依赖，
    扫描 0Harmony / MonoMod.* / Mono.Cecil 时会记录
    "Could not load MonoMod.Utils / Mono.Cecil" 和 ReflectionTypeLoadException。
    依赖统一放 <plugins>/<AssemblyName>.deps/，由 Plugin 的 AssemblyResolve 回调按需加载。
  -->
  <Target Name="DeployPluginDependencies" AfterTargets="PostBuild"
          Condition="'$(EmbyPluginPath)' != '' AND '$(TargetFramework)' != ''">
    <ItemGroup>
      <PluginDependency Include="$(TargetDir)*.dll" Exclude="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginDependency)"
          DestinationFolder="$(EmbyPluginPath)/$(AssemblyName).deps"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
